[Unit]
Description=b6charger-ctl self-update (pull-based, see self_update.sh)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Needs root: writes the install root, writes /etc/systemd/system, and
# runs systemctl. The httpd service itself stays unprivileged - only
# the updater needs this.
ExecStart=/bin/sh /opt/b6charger-ctl/src/systemd/charger-pi/self_update.sh
# A hung download or health check must not pin the timer's unit forever.
TimeoutStartSec=20min
