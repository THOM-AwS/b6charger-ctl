# Unit for a host kept in sync by self_update.sh / b6charger-self-update.timer.
# See ../b6charger-httpd.service.example for the hand-installed template.
#
# Do not hand-edit the live copy in /etc/systemd/system - the updater
# overwrites it on the next cycle. Host-specific settings (User=, the
# packs.toml path, the listen port) belong in the drop-in
# /etc/systemd/system/b6charger-httpd.service.d/10-host.conf, which the
# updater creates once from the live unit and then never touches.
# Everything else is a normal commit to this repo.

[Unit]
Description=b6charger-ctl HTTP daemon (b6ctl serve)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple

# A non-root account in the group the udev rule grants hidraw access to
# (see ../udev/99-b6charger.rules.example). Override in the drop-in.
User=tom

WorkingDirectory=/opt/b6charger-ctl/src

# Explicit path, not relative to WorkingDirectory - see README's
# "Configure your batteries" section for why systemd needs this set
# explicitly rather than relying on the CWD-relative default.
Environment=B6CTL_PACKS=/opt/b6charger-ctl/packs.toml

# Read-only by default: no --enable-writes, so starting or stopping a
# charge over the network is impossible from this unit. Use the CLI on
# the host for that. Override the port (or add --enable-writes plus a
# B6CTL_WRITE_TOKEN) in the drop-in, not here.
ExecStart=/usr/bin/python3 -m b6charger.cli serve --port 9101

Restart=on-failure
RestartSec=5
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
